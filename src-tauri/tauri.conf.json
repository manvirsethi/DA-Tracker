{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DA Tracker",
  "version": "0.1.0",
  "identifier": "com.manvirsethi.datracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DA Tracker",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Private degree apprenticeship tracker for Mac and iPhone.",
    "longDescription": "DA Tracker securely synchronises degree apprenticeship applications, statuses, deadlines and notes using Supabase."
  }
}
